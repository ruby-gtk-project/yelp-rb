#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Ruby port of Yelp.
#
# Ported from upstream's src/yelp.c: build the application and run it with
# the process's own argv, so Gio::Application's own command-line handling
# (which this port's Application does not override) sees it.
#
# Upstream's `-e, --editor-mode` switch (yelp_application_cmdline's
# GOptionEntry table) is not accepted here. I have not wired it through —
# editor mode changes how `lib/yelp_uri.rb`'s `resolve_gfile` falls back to
# an `index.page.stub` and how the document pipeline renders a page once
# there is a document pipeline (see FINDINGS.md), and neither of those
# reads a flag yet. `--version` is accepted, since it needs nothing but
# the gem's own version constant.

require "yelp"
require_relative "../lib/yelp/rb/version"

if ARGV.include?("--version")
  puts "yelp-rb #{Yelp::Rb::VERSION}"
  exit(0)
end

Application.new.run
